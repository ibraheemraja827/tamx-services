# Is file ko copy karke ".env" naam se banayein aur apni values bharein.
# ".env" ko kabhi GitHub par upload na karein.

PORT=5000
ALLOWED_ORIGIN=http://localhost:5173

# Email server (SMTP). Gmail ke liye: smtp.gmail.com, port 587, aur "App Password"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourcompany@gmail.com
SMTP_PASS=your-app-password

# Jis email par quote requests aani chahiye
QUOTE_TO=sales@yourcompany.com

# true karne par customer ko bhi confirmation email jata hai
SEND_AUTOREPLY=true
